{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengym",
  "main": "./src/index.js",
  // >= 2026-08-04 enables nodejs_compat and nodejs_compat_v2 implicitly, which is what makes
  // node:crypto (createHmac / randomBytes / timingSafeEqual) and Buffer available unchanged.
  "compatibility_date": "2026-09-02",
  "observability": { "enabled": true },

  // Must match RP_ID / ORIGIN below exactly — a passkey is bound to the hostname it was created
  // on, and changing RP_ID later invalidates every passkey already registered.
  "routes": [
    { "pattern": "opengym.rcn.sh", "custom_domain": true }
  ],

  // The whole point of serving the frontend from the same Worker: passkeys require a single
  // origin, so there is no nginx and no second hostname. run_worker_first keeps /api/* off the
  // asset path; everything else falls through to the built SPA.
  "assets": {
    "directory": "../frontend/dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opengym",
      "database_id": "95de5971-bed3-49de-96a4-5d46b4b9f884"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "REST_TIMER", "class_name": "RestTimer" }]
  },

  // SQLite-backed is the only class the Workers Free plan can create, and it is what the alarms
  // API needs here.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RestTimer"] }
  ],

  // Upstream scans every user every 10s. One minute is the finest granularity Cron Triggers
  // offer, so a day reminder can land up to ~60s after its target minute instead of ~9s.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Non-secret configuration. RP_ID and ORIGIN must agree with the hostname the app is served
  // from or every passkey ceremony fails; changing RP_ID later invalidates existing passkeys.
  // Secrets are NOT here — SESSION_SECRET, VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are set with
  // `wrangler secret put`.
  "vars": {
    "RP_ID": "opengym.rcn.sh",
    "ORIGIN": "https://opengym.rcn.sh",
    "RP_NAME": "openGym",
    "INVITE_ONLY": "1",
    "ALLOW_GUEST": "0",
    "SESSION_DAYS": "90",
    "AUDIT_LOG": "1",
    "AUDIT_IP": "net",
    "AUDIT_MAX": "5000",
    "AUDIT_DAYS": "0"
    // ADMIN_UIDS is deliberately absent: it is set with `wrangler secret put ADMIN_UIDS`.
    // It is not a credential — a uid is useless without the matching passkey — but this repo is
    // public, and naming the admin account in it only tells someone which account to go after.
    // A fresh clone therefore deploys with no admin, which matches upstream's default.
  },

  "dev": {
    "port": 8787
  }
}
