# Exercise media — fetched on first `docker compose up` (or via scripts/fetch-media.sh)
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Cloudflare Worker — local runtime state and secrets.
# .dev.vars holds a real SESSION_SECRET and VAPID private key for `wrangler dev`; deployed
# secrets live in `wrangler secret put`, never in the repo.
worker/.wrangler/
worker/.build/
worker/.dev.vars

# Backup of the deployed Worker secrets. Cloudflare stores secrets write-only — there is no way
# to read one back — so this file is the ONLY copy. Losing SESSION_SECRET signs everyone out;
# losing the VAPID keys kills every push subscription.
# NOTE: `git clean -xfd` deletes ignored files. Keep a copy off this machine.
worker/.secrets.backup

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
